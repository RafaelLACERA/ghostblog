global:
  scrape_interval: 15s

scrape_configs:
  - job_name: supervision
    static_configs:
      - targets:
          - "host.docker.internal:9100"
        labels:
          env: supervision
{% if monitoring_app_target %}
  - job_name: app
    static_configs:
      - targets:
          - "{{ monitoring_app_target }}"
        labels:
          env: app
{% endif %}
{% if monitoring_staging_target %}
  - job_name: staging
    static_configs:
      - targets:
          - "{{ monitoring_staging_target }}"
        labels:
          env: staging
{% endif %}
  # Boite noire : on demande a blackbox de tester l'URL publique de chaque site
  - job_name: site
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for site in monitoring_site_targets %}
          - "{{ site }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
