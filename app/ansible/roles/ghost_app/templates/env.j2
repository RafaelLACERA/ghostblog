{# docker-compose.yml reference ces valeurs via ${VAR} : tout "$" litteral
   doit etre echappe en "$$", sinon Docker Compose le reinterprete comme le
   debut d'une nouvelle reference de variable (ex: "$n" dans un mot de passe
   devient une reference a une variable "n" absente, remplacee par du vide -
   constate en test reel avec un vrai mot de passe RDS genere). #}
DB_HOST="{{ ghost_app_db_host | replace('$', '$$') }}"
DB_PORT="{{ ghost_app_db_port }}"
DB_NAME="{{ ghost_app_db_name | replace('$', '$$') }}"
DB_USER="{{ ghost_app_db_user | replace('$', '$$') }}"
DB_PASSWORD="{{ ghost_app_db_password | replace('$', '$$') }}"
GHOST_URL="{{ ghost_app_url | replace('$', '$$') }}"
IMAGE_TAG="{{ ghost_app_image_tag | replace('$', '$$') }}"
STORAGE_ACTIVE="s3"
S3_BUCKET="{{ ghost_app_s3_bucket | replace('$', '$$') }}"
