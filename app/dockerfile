
FROM ghost:6-alpine

# Suite a l'ajout du scan trivy (scan_ghost_image) : mise a jour des paquets
# de l'image ghost:6-alpine pour patcher le systeme (apk update && apk upgrade).
# Apres recherche, certaines vulnerabilites detectees viennent de binaires et
# dependances npm fournis tels quels par l'image ghost:6-alpine elle-meme
# (pas geres par apk) : risque documente et accepte en attendant une mise a
# jour de l'image officielle.
RUN apk update && apk upgrade --no-cache

WORKDIR /var/lib/ghost

# Adaptateur de stockage S3 : les medias uploades (images, themes) survivent
# ainsi a la destruction/recreation de l'instance EC2 (voir bucket S3 dans
# app/terraform/persistent). Version figee comme les autres dependances du
# projet. https://github.com/colinmeinke/ghost-storage-adapter-s3
#
# Piege : l'image ghost:6-alpine declare VOLUME /var/lib/ghost/content dans
# son propre Dockerfile - un volume herite comme ca ne peut pas etre retire
# par une image fille, et Docker cree un volume anonyme dessus a CHAQUE
# demarrage de conteneur, qui masquerait tout ce qu'on copierait dans
# content/ au moment du build. La bonne cible est content.orig/ : c'est
# l'entrypoint officiel de l'image (docker-entrypoint.sh) qui copie tout
# ce qui manque de content.orig/ vers le vrai content/ (le volume) au
# demarrage, avant de lancer Ghost - mecanisme prevu pour exactement ce cas.
RUN npm install ghost-storage-adapter-s3@2.8.0 --no-save && \
    mkdir -p content.orig/adapters/storage && \
    cp -r node_modules/ghost-storage-adapter-s3 content.orig/adapters/storage/s3

# Optionnel : copier un theme personnalise ici. Cible content.orig/, pas
# content/ (meme piege de volume que l'adaptateur S3 ci-dessus - voir le
# commentaire plus haut) : l'entrypoint de l'image hydrate aussi chaque
# theme individuellement depuis content.orig/themes/*.
# COPY ./mon-theme-custom ./content.orig/themes/mon-theme-custom

# On expose le port par défaut
EXPOSE 2368