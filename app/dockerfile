
FROM ghost:6-alpine

# Suite a l'ajout du scan trivy (scan_ghost_image) : mise a jour des paquets
# de l'image ghost:6-alpine pour patcher le systeme (apk update && apk upgrade).
# Apres recherche, certaines vulnerabilites detectees viennent de binaires et
# dependances npm fournis tels quels par l'image ghost:6-alpine elle-meme
# (pas geres par apk) : risque documente et accepte en attendant une mise a
# jour de l'image officielle.
RUN apk update && apk upgrade --no-cache

WORKDIR /var/lib/ghost

# Adaptateur de stockage S3 : les medias uploades (images, themes) survivent
# ainsi a la destruction/recreation de l'instance EC2 (voir bucket S3 dans
# app/terraform/persistent). Version figee comme les autres dependances du
# projet. https://github.com/colinmeinke/ghost-storage-adapter-s3
RUN npm install ghost-storage-adapter-s3@2.8.0 --no-save && \
    mkdir -p content/adapters/storage && \
    cp -r node_modules/ghost-storage-adapter-s3 content/adapters/storage/s3

# Optionnel :copier un thème personnalisé ici
# COPY ./mon-theme-custom ./content/themes/mon-theme-custom

# On expose le port par défaut
EXPOSE 2368